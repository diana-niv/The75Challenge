<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oops! Something went wrong | FitChallenge</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .error-container {
            max-width: 600px;
            margin: 0 auto;
            padding: 0 20px;
            text-align: center;
        }

        .error-card {
            background: white;
            border-radius: 20px;
            padding: 3rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
        }

        .error-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(45deg, #ff6b6b, #ee5a52);
        }

        .error-icon {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(45deg, #ff6b6b, #ee5a52);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3rem;
            margin: 0 auto 2rem;
            box-shadow: 0 10px 30px rgba(255, 107, 107, 0.3);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                transform: scale(1);
                box-shadow: 0 10px 30px rgba(255, 107, 107, 0.3);
            }
            50% {
                transform: scale(1.05);
                box-shadow: 0 15px 40px rgba(255, 107, 107, 0.4);
            }
            100% {
                transform: scale(1);
                box-shadow: 0 10px 30px rgba(255, 107, 107, 0.3);
            }
        }

        .error-title {
            font-size: 2.5rem;
            color: #333;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .error-subtitle {
            font-size: 1.2rem;
            color: #666;
            margin-bottom: 2rem;
        }

        .error-message {
            background: linear-gradient(135deg, #fff5f5 0%, #ffffff 100%);
            border: 2px solid #ffebee;
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            border-left: 4px solid #ff6b6b;
        }

        .error-message p {
            color: #d32f2f;
            font-weight: 500;
            margin: 0;
            word-break: break-word;
        }

        .error-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 1rem 2rem;
            border: none;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1rem;
        }

        .btn-primary {
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
        }

        .btn-secondary {
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

        .btn-primary:hover {
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        /* Fun elements */
        .error-details {
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 2px solid #f0f0f0;
        }

        .error-code {
            font-family: 'Courier New', monospace;
            background: #f8f9fa;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            color: #666;
            font-size: 0.9rem;
            display: inline-block;
            margin-bottom: 1rem;
        }

        .helpful-tips {
            text-align: left;
            background: linear-gradient(135deg, #f8f9ff 0%, #ffffff 100%);
            border-radius: 15px;
            padding: 1.5rem;
            margin-top: 2rem;
        }

        .helpful-tips h4 {
            color: #667eea;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .helpful-tips ul {
            list-style: none;
            padding: 0;
        }

        .helpful-tips li {
            padding: 0.5rem 0;
            color: #666;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .helpful-tips li:before {
            content: "💡";
            font-size: 1.2rem;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .error-card {
                padding: 2rem;
            }

            .error-title {
                font-size: 2rem;
            }

            .error-actions {
                flex-direction: column;
                align-items: center;
            }

            .helpful-tips {
                text-align: center;
            }
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in-up {
            animation: fadeInUp 0.6s ease-out;
        }

        .error-card {
            animation: fadeInUp 0.6s ease-out;
        }

        /* Floating elements */
        .floating-shapes {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .shape {
            position: absolute;
            opacity: 0.1;
            animation: float 6s ease-in-out infinite;
        }

        .shape:nth-child(1) {
            top: 20%;
            left: 10%;
            animation-delay: 0s;
        }

        .shape:nth-child(2) {
            top: 60%;
            right: 10%;
            animation-delay: 2s;
        }

        .shape:nth-child(3) {
            bottom: 20%;
            left: 20%;
            animation-delay: 4s;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0px) rotate(0deg);
            }
            50% {
                transform: translateY(-20px) rotate(180deg);
            }
        }
    </style>
</head>
<body>
<!-- Floating Background Shapes -->
<div class="floating-shapes">
    <div class="shape">
        <i class="fas fa-dumbbell" style="font-size: 3rem; color: white;"></i>
    </div>
    <div class="shape">
        <i class="fas fa-heart" style="font-size: 2.5rem; color: white;"></i>
    </div>
    <div class="shape">
        <i class="fas fa-star" style="font-size: 2rem; color: white;"></i>
    </div>
</div>

<!-- Error Container -->
<div class="error-container">
    <div class="error-card fade-in-up">
        <div class="error-icon" style="<%= error === 'Access Denied' ? 'background: linear-gradient(45deg, #ff9800, #f57c00);' : '' %>">
            <i class="<%= error === 'Access Denied' ? 'fas fa-lock' : 'fas fa-exclamation-triangle' %>"></i>
        </div>

        <h1 class="error-title">
            <% if (error === 'Access Denied') { %>
                <i class="fas fa-lock"></i> Access Denied
            <% } else { %>
                Oops! Something went wrong
            <% } %>
        </h1>
        <p class="error-subtitle">
            <% if (error === 'Access Denied') { %>
                You don't have permission to access this resource
            <% } else { %>
                Don't worry, even the strongest athletes stumble sometimes!
            <% } %>
        </p>

        <div class="error-message">
            <p>
                <% if (typeof message !== 'undefined' && message) { %>
                    <%= message %>
                <% } else { %>
                    <%= error %>
                <% } %>
            </p>
        </div>

        <div class="error-code">
            Error Code: <%= typeof errorCode !== 'undefined' ? errorCode : 'UNKNOWN' %>
        </div>

        <div class="error-actions">
            <a href="/" class="btn btn-primary">
                <i class="fas fa-home"></i>
                Take Me Home
            </a>
            <button onclick="history.back()" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i>
                Go Back
            </button>
        </div>

        <div class="helpful-tips">
            <h4>
                <i class="fas fa-lightbulb"></i>
                <% if (error === 'Access Denied') { %>
                    What you can do:
                <% } else { %>
                    What you can try:
                <% } %>
            </h4>
            <ul>
                <% if (error === 'Access Denied') { %>
                    <li>Make sure you're logged in with the correct account</li>
                    <li>Only view your own profile page</li>
                    <li>Contact an administrator if you need access</li>
                    <li>Go back to the previous page</li>
                <% } else { %>
                    <li>Check your internet connection</li>
                    <li>Refresh the page and try again</li>
                    <li>Make sure you're logged in</li>
                    <li>Contact support if the problem persists</li>
                <% } %>
            </ul>
        </div>

        <div class="error-details">
            <p style="color: #999; font-size: 0.9rem;">
                <i class="fas fa-clock"></i>
                Error occurred at: <span id="errorTime"></span>
            </p>
        </div>
    </div>
</div>

<script>
    // ========================================
    // ERROR PAGE INTERACTIONS AND FEATURES
    // ========================================
    
    // ========================================
    // ERROR TIMESTAMP DISPLAY
    // ========================================
    
    /**
     * Displays the current timestamp when the error occurred
     * Helps users and developers track when issues happen
     */
    document.getElementById('errorTime').textContent = new Date().toLocaleString();

    // ========================================
    // INTERACTIVE ERROR ICON
    // ========================================
    
    /**
     * Adds interactive animation to error icon on click
     * Provides visual feedback and makes the page more engaging
     */
    document.querySelector('.error-icon').addEventListener('click', function() {
        // Trigger immediate pulse animation
        this.style.animation = 'pulse 0.5s ease-in-out';
        
        // Reset to continuous pulse animation after initial animation
        setTimeout(() => {
            this.style.animation = 'pulse 2s infinite';
        }, 500);
    });

    // ========================================
    // AUTO-REDIRECT FUNCTIONALITY (OPTIONAL)
    // ========================================
    
    /**
     * Optional auto-redirect countdown system
     * Automatically redirects users to home page after 30 seconds
     * Currently disabled but can be enabled by uncommenting code below
     */
    let countdown = 30;
    const countdownElement = document.createElement('p');
    countdownElement.style.cssText = 'color: #999; font-size: 0.9rem; margin-top: 1rem;';
    countdownElement.innerHTML = `<i class="fas fa-clock"></i> Auto-redirecting to home in <span id="countdown">${countdown}</span> seconds`;

    // Uncomment the lines below if you want auto-redirect functionality
    // document.querySelector('.error-details').appendChild(countdownElement);
    // const timer = setInterval(() => {
    //     countdown--;
    //     document.getElementById('countdown').textContent = countdown;
    //     if (countdown <= 0) {
    //         clearInterval(timer);
    //         window.location.href = '/';
    //     }
    // }, 1000);
</script>
</body>
</html>
