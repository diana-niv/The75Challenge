<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.name %> <%= user.surname %> - Profile | Server Side Eye</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }

        /* Background with overlay */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('/background.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            z-index: -2;
        }

        body::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg,
            rgba(102, 126, 234, 0.8) 0%,
            rgba(118, 75, 162, 0.7) 50%,
            rgba(102, 126, 234, 0.8) 100%);
            z-index: -1;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header */
        header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(15px);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 0;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: bold;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo img {
            height: 40px;
            width: 40px;
            object-fit: contain;
        }

        .nav-buttons {
            display: flex;
            gap: 1rem;
            padding: 0.5rem;
        }

        .nav-buttons .btn {
            padding: 0.8rem 1.8rem;
            border: none;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
        }

        .nav-buttons .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .nav-buttons .btn-secondary {
            background: rgba(255, 255, 255, 0.95);
            color: #333;
            border: 2px solid rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .nav-buttons .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .nav-buttons .btn-primary:hover {
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        }

        .nav-buttons .btn-logout {
            background: transparent;
            color: #667eea;
            border: none;
            box-shadow: none;
            font-weight: 500;
        }

        .nav-buttons .btn-logout:hover {
            background: rgba(102, 126, 234, 0.1);
            color: #5a67d8;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.2);
        }

        /* Main Content */
        .main-content {
            padding: 120px 0 80px;
            min-height: 100vh;
            position: relative;
        }

        .profile-header {
            text-align: center;
            margin-bottom: 4rem;
            color: white;
        }

        .profile-header h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            font-weight: 800;
            color: white;
            text-shadow: 2px 4px 8px rgba(0, 0, 0, 0.3);
        }

        .profile-header p {
            font-size: 1.3rem;
            color: white;
            text-shadow: 1px 2px 4px rgba(0, 0, 0, 0.2);
        }

        /* Profile Grid */
        .profile-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 3rem;
            margin-bottom: 3rem;
        }

        /* Profile Card */
        .profile-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 3rem;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
            text-align: center;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
            height: fit-content;
        }

        .profile-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .profile-avatar {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3.5rem;
            font-weight: bold;
            margin: 0 auto 2rem;
            box-shadow: 0 15px 35px rgba(102, 126, 234, 0.3);
            position: relative;
            overflow: hidden;
        }

        .profile-picture {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 2rem;
            box-shadow: 0 15px 35px rgba(102, 126, 234, 0.3);
        }

        .profile-name {
            font-size: 2.2rem;
            color: #333;
            margin-bottom: 0.8rem;
            font-weight: 800;
        }

        .profile-id {
            color: #667eea;
            font-weight: 700;
            margin-bottom: 1.5rem;
            font-size: 1.2rem;
            background: rgba(102, 126, 234, 0.1);
            padding: 0.5rem 1rem;
            border-radius: 15px;
            display: inline-block;
        }

        .profile-email {
            color: #666;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
            font-size: 1.1rem;
            font-weight: 500;
        }

        /* Stats Card */
        .stats-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 3rem;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .stats-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
        }

        .stats-title {
            font-size: 2rem;
            color: #333;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            font-weight: 800;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1.5rem;
        }

        .stat-item {
            text-align: center;
            padding: 1.5rem;
            background: rgba(248, 249, 255, 0.8);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 2px solid rgba(102, 126, 234, 0.1);
            transition: all 0.3s ease;
        }

        .stat-item:hover {
            border-color: #667eea;
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.2);
        }

        .stat-number {
            font-size: 2.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: block;
        }

        .stat-label {
            color: #666;
            font-size: 1rem;
            margin-top: 0.8rem;
            font-weight: 600;
        }

        .progress-bar {
            width: 100%;
            height: 10px;
            background: rgba(102, 126, 234, 0.2);
            border-radius: 5px;
            margin: 1.5rem 0;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
            border-radius: 5px;
            transition: width 1s ease;
        }

        /* Badges Section */
        .badges-section {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 3rem;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
            margin-bottom: 3rem;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .badges-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
        }

        .section-title {
            font-size: 2rem;
            color: #333;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            font-weight: 800;
        }

        .badges-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .badge {
            padding: 2rem;
            border-radius: 20px;
            text-align: center;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .badge.earned {
            background: linear-gradient(135deg, rgba(76, 175, 80, 0.1) 0%, rgba(76, 175, 80, 0.05) 100%);
            border: 2px solid rgba(76, 175, 80, 0.3);
            box-shadow: 0 10px 25px rgba(76, 175, 80, 0.2);
        }

        .badge.not-earned {
            background: rgba(245, 245, 245, 0.8);
            backdrop-filter: blur(10px);
            border: 2px solid rgba(221, 221, 221, 0.5);
        }

        .badge:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
        }

        .badge-icon {
            font-size: 3rem;
            margin-bottom: 1.5rem;
        }

        .badge.earned .badge-icon {
            color: #4CAF50;
        }

        .badge.not-earned .badge-icon {
            color: #ccc;
        }

        .badge-name {
            font-weight: 700;
            font-size: 1.2rem;
            margin-bottom: 0.8rem;
            color: #333;
        }

        .badge-description {
            font-size: 1rem;
            color: #666;
            line-height: 1.5;
        }

        /* Progress List */
        .progress-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
        }

        .progress-item {
            display: flex;
            align-items: center;
            padding: 1rem;
            border-radius: 15px;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .progress-item.earned {
            background: rgba(76, 175, 80, 0.1);
            border-left: 4px solid #4CAF50;
        }

        .progress-item.not-earned {
            background: rgba(245, 245, 245, 0.8);
            border-left: 4px solid #ddd;
        }

        .progress-icon {
            margin-right: 1rem;
            font-size: 1.5rem;
        }

        .progress-name {
            font-weight: 600;
            color: #333;
        }

        /* Communities Section */
        .communities-section {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 3rem;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
            margin: 3rem 0;
            animation: fadeInUp 0.8s ease-out;
            animation-delay: 0.3s;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .communities-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .communities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .community-card {
            background: rgba(248, 249, 255, 0.8);
            backdrop-filter: blur(15px);
            border: 2px solid rgba(102, 126, 234, 0.1);
            border-radius: 20px;
            padding: 2rem;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
            position: relative;
            overflow: hidden;
        }

        .community-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .community-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 15px 40px rgba(102, 126, 234, 0.2);
            border-color: rgba(102, 126, 234, 0.3);
        }

        .community-card:hover::before {
            transform: scaleX(1);
        }

        .community-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        }

        .community-name {
            font-size: 1.4rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 0.8rem;
        }

        .community-description {
            color: #666;
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .community-action {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            color: #667eea;
            font-weight: 600;
            font-size: 1rem;
        }

        .no-communities {
            text-align: center;
            padding: 4rem 2rem;
            color: #666;
        }

        .no-communities i {
            font-size: 5rem;
            color: #667eea;
            margin-bottom: 2rem;
            opacity: 0.7;
        }

        .no-communities h3 {
            font-size: 1.8rem;
            margin-bottom: 1rem;
            color: #333;
            font-weight: 700;
        }

        .no-communities p {
            margin-bottom: 2rem;
            font-size: 1.1rem;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            margin-top: 3rem;
        }

        .btn {
            padding: 1.2rem 2.5rem;
            border: none;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.8rem;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-danger {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
            color: white;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
        }

        /* No badges state */
        .no-badges {
            text-align: center;
            padding: 4rem;
            color: #666;
        }

        .no-badges i {
            font-size: 5rem;
            color: #667eea;
            margin-bottom: 2rem;
            opacity: 0.7;
        }

        .no-badges h3 {
            font-size: 1.8rem;
            margin-bottom: 1rem;
            color: #333;
            font-weight: 700;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .nav-buttons {
                flex-direction: column;
                gap: 0.8rem;
            }

            .profile-grid {
                grid-template-columns: 1fr;
            }

            .profile-header h1 {
                font-size: 2.5rem;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .badges-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
                align-items: center;
            }

            .progress-list {
                grid-template-columns: 1fr;
            }

            .communities-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in-up {
            animation: fadeInUp 0.8s ease-out;
        }

        .profile-card,
        .stats-card,
        .badges-section {
            animation: fadeInUp 0.8s ease-out;
        }

        .stats-card {
            animation-delay: 0.1s;
        }

        .badges-section {
            animation-delay: 0.2s;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        .profile-header {
            animation: float 6s ease-in-out infinite;
        }
    </style>
</head>
<body>
<!-- Header -->
<header>
    <nav class="container">
        <div class="logo">
            <img src="/logo.png" alt="Server Side Eye Logo">
            <span>
                <i class="fas fa-dumbbell"></i>
                75Challenge
            </span>
        </div>
                 <div class="nav-buttons">
             <a href="/users" class="btn btn-secondary">
                 <i class="fas fa-users"></i> Users
             </a>
             <a href="/communities" class="btn btn-secondary">
                 <i class="fas fa-users-cog"></i> Communities
             </a>
             <a href="/chat" class="btn btn-secondary">
                 <i class="fas fa-comments"></i> Chat
             </a>
             <% if (currentUser) { %>
                 <a href="/users/<%= currentUser.id %>" class="btn btn-primary">
                     <i class="fas fa-user-circle"></i> Profile
                 </a>
             <% } %>
                         <a href="/logout" class="btn btn-logout">
                 <i class="fas fa-sign-out-alt"></i> Logout
             </a>
        </div>
    </nav>
</header>

<!-- Main Content -->
<main class="main-content">
    <div class="container">
        <!-- Profile Header -->
        <div class="profile-header">
            <h1>Profile</h1>
            <p>Welcome back, <%= user.name %>!</p>
        </div>

        <!-- Profile Grid -->
        <div class="profile-grid">
            <!-- Profile Card -->
            <div class="profile-card">
                <% if (user.profile_pic) { %>
                    <img src="/uploads/profiles/<%= user.profile_pic %>" alt="Profile Picture" class="profile-picture">
                <% } else { %>
                    <div class="profile-avatar">
                        <%= user.name.charAt(0).toUpperCase() %><%= user.surname.charAt(0).toUpperCase() %>
                    </div>
                <% } %>
                <div class="profile-name"><%= user.name %> <%= user.surname %></div>
                <div class="profile-id">ID: <%= user.id %></div>
                <div class="profile-email">
                    <i class="fas fa-envelope"></i>
                    <%= user.email || 'No email provided' %>
                </div>
            </div>

            <!-- Challenge Stats -->
            <% if (typeof stats !== 'undefined' && stats) { %>
                <div class="stats-card">
                    <h3 class="stats-title">
                        <i class="fas fa-chart-line"></i>
                        Challenge Progress
                    </h3>
                    <div class="stats-grid">
                        <div class="stat-item">
                            <span class="stat-number"><%= stats.completed_days || 0 %></span>
                            <div class="stat-label">Completed Days</div>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number"><%= stats.failed_days || 0 %></span>
                            <div class="stat-label">Failed Days</div>
                        </div>
                        <div class="stat-item">
                            <span class="stat-number"><%= stats.total_days || 0 %></span>
                            <div class="stat-label">Total Days</div>
                        </div>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: <%= Math.min(((stats.completed_days || 0) / 75) * 100, 100) %>%"></div>
                    </div>
                    <p style="text-align: center; color: #666; margin-top: 1rem; font-weight: 600;">
                        <%= Math.min(((stats.completed_days || 0) / 75) * 100, 100).toFixed(1) %>% Complete
                    </p>
                </div>
            <% } else { %>
                <div class="stats-card">
                    <h3 class="stats-title">
                        <i class="fas fa-chart-line"></i>
                        Challenge Progress
                    </h3>
                    <div style="text-align: center; padding: 3rem; color: #666;">
                        <i class="fas fa-rocket" style="font-size: 4rem; margin-bottom: 1.5rem; color: #667eea; opacity: 0.7;"></i>
                        <h4 style="font-size: 1.5rem; margin-bottom: 1rem; color: #333;">Ready to Start Your Journey?</h4>
                        <p style="font-size: 1.1rem;">Join a community to begin tracking your progress!</p>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- Badges Section -->
        <div class="badges-section">
            <h3 class="section-title">
                <i class="fas fa-trophy"></i>
                Achievements & Badges
            </h3>
            <% if (typeof userBadges !== 'undefined' && userBadges && userBadges.length > 0) { %>
                <h4 style="margin-bottom: 1.5rem; color: #4CAF50; font-size: 1.3rem; font-weight: 700;">
                    <i class="fas fa-medal"></i> Earned Badges (<%= userBadges.length %>)
                </h4>
                <div class="badges-grid">
                    <% userBadges.forEach(badge => { %>
                        <div class="badge earned">
                            <img class="badge-icon" src="/uploads/badges/<%= badge.img_path %>" alt="<%= badge.name %> badge" style="height: 80px; width: 80px; object-fit: contain;">
                            <div class="badge-name"><%= badge.name %></div>
                            <div class="badge-description"><%= badge.description %></div>
                        </div>
                    <% }) %>
                </div>
            <% } %>

            <!-- Badge Progress Section -->
            <% if (typeof badgeProgress !== 'undefined' && badgeProgress) { %>
                <h4 style="margin: 3rem 0 1.5rem 0; color: #667eea; font-size: 1.3rem; font-weight: 700;">
                    <i class="fas fa-tasks"></i> Badge Progress
                </h4>
                <div class="progress-list">
                    <% Object.entries(badgeProgress).forEach(([badgeName, isEarned]) => { %>
                        <div class="progress-item <%= isEarned ? 'earned' : 'not-earned' %>">
                            <span class="progress-icon"><%= isEarned ? '✅' : '⭕' %></span>
                            <span class="progress-name"><%= badgeName %></span>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Communities Section -->
        <div class="communities-section">
            <h3 class="section-title">
                <i class="fas fa-users"></i>
                My Communities (<%= userCommunities ? userCommunities.length : 0 %>)
            </h3>
            <% if (userCommunities && userCommunities.length > 0) { %>
                <div class="communities-grid">
                    <% userCommunities.forEach(community => { %>
                        <div class="community-card" onclick="location.href='/communities/<%= community.id %>'">
                            <div class="community-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="community-name"><%= community.name %></div>
                            <div class="community-description">
                                <%= community.description || 'Join this amazing community and start your fitness journey!' %>
                            </div>
                            <div class="community-action">
                                <i class="fas fa-arrow-right"></i>
                                View Community
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="no-communities">
                    <i class="fas fa-users"></i>
                    <h3>No Communities Yet</h3>
                    <p>Join communities to connect with others and participate in challenges!</p>
                    <a href="/communities" class="btn btn-primary">
                        <i class="fas fa-plus"></i>
                        Browse Communities
                    </a>
                </div>
            <% } %>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a href="/users/<%= user.id %>/edit" class="btn btn-primary">
                <i class="fas fa-edit"></i>
                Edit Profile
            </a>
            <form action="/users/<%= user.id %>?_method=DELETE" method="post"
                  onsubmit="return confirm('Are you sure you want to delete this user?')"
                  style="display: inline;">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i>
                    Delete Profile
                </button>
            </form>
        </div>
    </div>
</main>

<script>
    // ========================================
    // USER PROFILE PAGE INTERACTIONS AND ANIMATIONS
    // ========================================
    
    // ========================================
    // SCROLL-BASED ANIMATIONS
    // ========================================
    
    /**
     * Configuration for Intersection Observer
     * Triggers animations when elements come into view
     */
    const observerOptions = {
        threshold: 0.1, // Trigger when 10% of element is visible
        rootMargin: '0px 0px -50px 0px' // Trigger 50px before element enters viewport
    };

    /**
     * Intersection Observer for scroll-triggered animations
     * Animates profile elements as they come into view
     */
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                // Animate element into view with fade and slide effect
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, observerOptions);

    /**
     * Initialize all profile elements with scroll-triggered animations
     * Sets up badges, stats, progress items, and community cards
     */
    document.querySelectorAll('.badge, .stat-item, .progress-item, .community-card').forEach((el, index) => {
        // Set initial hidden state
        el.style.opacity = '0';
        el.style.transform = 'translateY(20px)';
        
        // Create staggered transition with increasing delay
        el.style.transition = `opacity 0.8s ease ${index * 0.05}s, transform 0.8s ease ${index * 0.05}s`;
        
        // Start observing this element for scroll animations
        observer.observe(el);
    });

    // ========================================
    // PROGRESS BAR ANIMATION
    // ========================================
    
    /**
     * Animates the challenge progress bar on page load
     * Creates a smooth fill animation for visual appeal
     */
    window.addEventListener('load', () => {
        const progressFill = document.querySelector('.progress-fill');
        if (progressFill) {
            // Trigger animation after a short delay for better visual effect
            setTimeout(() => {
                progressFill.style.width = progressFill.style.width;
            }, 500);
        }
    });

    // ========================================
    // INTERACTIVE HOVER EFFECTS
    // ========================================
    
    /**
     * Adds hover effects to profile cards and elements
     * Provides visual feedback and enhances user interaction
     */
    document.querySelectorAll('.badge, .stat-item, .community-card').forEach(card => {
        // Add hover effect - lift and slightly scale up
        card.addEventListener('mouseenter', () => {
            card.style.transform = 'translateY(-5px) scale(1.02)';
        });

        // Reset to normal state when mouse leaves
        card.addEventListener('mouseleave', () => {
            card.style.transform = 'translateY(0) scale(1)';
        });
    });

    // ========================================
    // PARALLAX BACKGROUND EFFECT
    // ========================================
    
    /**
     * Creates parallax scrolling effect for background
     * Moves background at half scroll speed for depth effect
     */
    window.addEventListener('scroll', () => {
        const scrolled = window.pageYOffset;
        document.body.style.backgroundPosition = `center ${scrolled * 0.5}px`;
    });
</script>
</body>
</html>
