<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Community - <%= community.name %> | FitChallenge</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background: url('/background.jpg') center/cover no-repeat fixed;
            min-height: 100vh;
            position: relative;
        }

        body::after {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg,
            rgba(102, 126, 234, 0.8) 0%,
            rgba(118, 75, 162, 0.7) 50%,
            rgba(102, 126, 234, 0.8) 100%);
            z-index: -1;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header - matching index.ejs exactly */
        header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(15px);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 0;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: bold;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo img {
            height: 40px;
            width: 40px;
            object-fit: contain;
        }

        .nav-buttons {
            display: flex;
            gap: 1rem;
            padding: 0.5rem;
        }

        .nav-buttons .btn {
            padding: 0.8rem 1.8rem;
            border: none;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
        }

        .nav-buttons .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .nav-buttons .btn-secondary {
            background: rgba(255, 255, 255, 0.95);
            color: #333;
            border: 2px solid rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .nav-buttons .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .nav-buttons .btn-primary:hover {
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        }

        .nav-buttons .btn-logout {
            background: transparent;
            color: #667eea;
            border: none;
            box-shadow: none;
            font-weight: 500;
        }

        .nav-buttons .btn-logout:hover {
            background: rgba(102, 126, 234, 0.1);
            color: #5a67d8;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.2);
        }

        /* Main Content */
        .main-content {
            padding: 120px 0 80px;
            min-height: 100vh;
        }

        .page-header {
            text-align: center;
            margin-bottom: 3rem;
            color: white;
        }

        .page-header h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            font-weight: 700;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .page-header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        .community-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255, 255, 255, 0.2);
            padding: 0.5rem 1rem;
            border-radius: 25px;
            color: white;
            font-weight: 600;
            margin-top: 1rem;
        }

        /* Form Section */
        .form-section {
            background: white;
            border-radius: 20px;
            padding: 3rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .form-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(45deg, #667eea, #764ba2);
        }

        .section-title {
            font-size: 2rem;
            color: #333;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-align: center;
            justify-content: center;
        }

        .form-group {
            margin-bottom: 2rem;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            color: #333;
            margin-bottom: 0.8rem;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-input {
            width: 100%;
            padding: 1.2rem;
            border: 2px solid #f0f0f0;
            border-radius: 15px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            background: #fafafa;
            font-family: inherit;
        }

        .form-input:focus {
            outline: none;
            border-color: #667eea;
            background: white;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            transform: translateY(-2px);
        }

        .form-input.textarea {
            min-height: 120px;
            resize: vertical;
        }

        .form-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 2rem;
        }

        .btn {
            padding: 1.2rem 2.5rem;
            border: none;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
        }

        .btn-secondary {
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

        .btn-primary:hover {
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }

        /* Preview Section */
        .preview-section {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .preview-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(45deg, #4CAF50, #45a049);
        }

        .preview-card {
            background: linear-gradient(135deg, #f8f9ff 0%, #ffffff 100%);
            border: 2px solid #f0f0f0;
            border-radius: 15px;
            padding: 2rem;
            text-align: center;
        }

        .preview-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(45deg, #667eea, #764ba2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            margin: 0 auto 1rem;
        }

        .preview-name {
            font-size: 1.5rem;
            color: #333;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .preview-description {
            color: #666;
            line-height: 1.5;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .nav-links {
                flex-direction: column;
                gap: 0.5rem;
            }

            .page-header h1 {
                font-size: 2rem;
            }

            .form-actions {
                flex-direction: column;
                align-items: center;
            }

            .form-section {
                padding: 2rem;
            }
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in-up {
            animation: fadeInUp 0.6s ease-out;
        }

        .form-section {
            animation: fadeInUp 0.6s ease-out;
        }

        .preview-section {
            animation: fadeInUp 0.6s ease-out 0.1s;
            animation-fill-mode: both;
        }

        /* Input animations */
        .form-input {
            animation: fadeInUp 0.6s ease-out;
        }

        .form-group:nth-child(2) .form-input {
            animation-delay: 0.1s;
        }

        .form-group:nth-child(3) .form-input {
            animation-delay: 0.2s;
        }
    </style>
</head>
<body>
<!-- Header -->
<header>
    <nav class="container">
        <div class="logo">
            <img src="/logo.png" alt="Server Side Eye Logo">
            <span>
                <i class="fas fa-dumbbell"></i>
                75Challenge
            </span>
        </div>
                 <div class="nav-buttons">
             <a href="/users" class="btn btn-secondary">
                 <i class="fas fa-users"></i> Users
             </a>
             <a href="/communities" class="btn btn-pilates">
                 <i class="fas fa-users-cog"></i> Communities
             </a>
             <a href="/chat" class="btn btn-secondary">
                 <i class="fas fa-comments"></i> Chat
             </a>
             <% if (currentUser) { %>
                 <a href="/users/<%= currentUser.id %>" class="btn btn-secondary">
                     <i class="fas fa-user-circle"></i> Profile
                 </a>
             <% } %>
                         <a href="/logout" class="btn btn-logout">
                 <i class="fas fa-sign-out-alt"></i> Logout
             </a>
        </div>
    </nav>
</header>

<!-- Main Content -->
<main class="main-content">
    <div class="container">
        <!-- Page Header -->
        <div class="page-header fade-in-up">
            <h1><i class="fas fa-edit"></i> Edit Community</h1>
            <p>Update your community information and settings</p>
            <div class="community-badge">
                <i class="fas fa-users"></i>
                <%= community.name %>
            </div>
        </div>

        <!-- Live Preview -->
        <div class="preview-section">
            <h2 class="section-title">
                <i class="fas fa-eye"></i>
                Live Preview
            </h2>
            <div class="preview-card">
                <div class="preview-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="preview-name" id="previewName"><%= community.name %></div>
                <div class="preview-description" id="previewDescription">
                    <%= community.description || 'No description provided' %>
                </div>
            </div>
        </div>

        <!-- Edit Form -->
        <div class="form-section">
            <h2 class="section-title">
                <i class="fas fa-cog"></i>
                Community Settings
            </h2>

            <form action="/communities/<%= community.id %>/edit" method="POST" id="editForm">
                <div class="form-group">
                    <label for="name">
                        <i class="fas fa-tag"></i>
                        Community Name
                    </label>
                    <input type="text"
                           id="name"
                           name="name"
                           class="form-input"
                           value="<%= community.name %>"
                           placeholder="Enter community name"
                           required>
                </div>

                <div class="form-group">
                    <label for="description">
                        <i class="fas fa-align-left"></i>
                        Description
                    </label>
                    <textarea id="description"
                              name="description"
                              class="form-input textarea"
                              placeholder="Describe your community..."
                              required><%= community.description %></textarea>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i>
                        Save Changes
                    </button>
                    <a href="/communities/<%= community.id %>" class="btn btn-secondary">
                        <i class="fas fa-times"></i>
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</main>

<script>
    // ========================================
    // COMMUNITY EDITING WITH LIVE PREVIEW
    // ========================================
    
    // Get DOM elements for live preview functionality
    const nameInput = document.getElementById('name');
    const descriptionInput = document.getElementById('description');
    const previewName = document.getElementById('previewName');
    const previewDescription = document.getElementById('previewDescription');

    // ========================================
    // LIVE PREVIEW FUNCTIONALITY
    // ========================================
    
    /**
     * Updates the live preview name as user types
     * Shows real-time changes to community name in preview card
     */
    nameInput.addEventListener('input', function() {
        previewName.textContent = this.value || 'Community Name';
    });

    /**
     * Updates the live preview description as user types
     * Shows real-time changes to community description in preview card
     */
    descriptionInput.addEventListener('input', function() {
        previewDescription.textContent = this.value || 'No description provided';
    });

    // ========================================
    // FORM SUBMISSION HANDLING
    // ========================================
    
    /**
     * Handles form submission with loading animation
     * Shows spinner and disables button to prevent double submission
     */
    document.getElementById('editForm').addEventListener('submit', function(e) {
        const submitBtn = document.querySelector('.btn-primary');
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving Changes...';
        submitBtn.disabled = true;
    });

    // ========================================
    // USER EXPERIENCE ENHANCEMENTS
    // ========================================
    
    // Auto-focus and select the name input for immediate editing
    nameInput.focus();
    nameInput.select();

    // ========================================
    // CHARACTER COUNTER FOR DESCRIPTION
    // ========================================
    
    const maxLength = 500; // Maximum characters allowed in description

    /**
     * Manages character counter for the description field
     * Shows remaining characters and provides visual feedback
     */
    descriptionInput.addEventListener('input', function() {
        const remaining = maxLength - this.value.length;
        
        // Create character counter element if it doesn't exist
        if (!document.querySelector('.char-counter')) {
            const counter = document.createElement('div');
            counter.className = 'char-counter';
            counter.style.cssText = 'text-align: right; font-size: 0.9rem; color: #666; margin-top: 0.5rem;';
            this.parentNode.appendChild(counter);
        }
        
        // Update counter text
        document.querySelector('.char-counter').textContent = `${remaining} characters remaining`;

        // Provide visual feedback based on character count
        if (remaining < 0) {
            // Over limit - show red warning
            this.style.borderColor = '#ff6b6b';
            document.querySelector('.char-counter').style.color = '#ff6b6b';
        } else if (this.value.length > 0) {
            // Has content - show green success
            this.style.borderColor = '#4CAF50';
            document.querySelector('.char-counter').style.color = '#4CAF50';
        } else {
            // Empty - show default styling
            this.style.borderColor = '#f0f0f0';
            document.querySelector('.char-counter').style.color = '#666';
        }
    });

    // Initialize character counter on page load
    descriptionInput.dispatchEvent(new Event('input'));
</script>
</body>
</html>
